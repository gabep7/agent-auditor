# Gemini API key — used by the auditor agent and the LLM-as-judge
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Arize Phoenix (Cloud or self-hosted) — required for tracing, evals and the
# self-improvement loop. Sign up at https://app.phoenix.arize.com.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-tenant>
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_PROJECT_NAME=agent-auditor
