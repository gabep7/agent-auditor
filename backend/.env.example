# Gemini API key — used by the auditor agent and the LLM-as-judge
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Arize Phoenix (Cloud or self-hosted) — required for tracing, evals and the
# self-improvement loop. Sign up at https://app.phoenix.arize.com.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-tenant>
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_PROJECT_NAME=agent-auditor

# Elasticsearch (optional) — export audit results for dashboards and alerting
# ELASTIC_ENDPOINT=https://your-deployment.es.io
# ELASTIC_API_KEY=your-elastic-api-key

# LLM remediation is ON by default (Gemini generates code-level fixes).
# Set to true to use heuristic fallback instead:
# DISABLE_LLM_REMEDIATION=false
